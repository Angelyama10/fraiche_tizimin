{
  email {$ACME_EMAIL}
  admin off
}

{$APP_DOMAIN}, www.{$APP_DOMAIN} {
  @www host www.{$APP_DOMAIN}
  redir @www https://{$APP_DOMAIN}{uri} permanent

  encode zstd gzip

  @nextStatic path /_next/static/*
  header @nextStatic Cache-Control "public, max-age=31536000, immutable"

  @dynamic {
    not path /_next/static/* /images/* /favicon.ico /manifest.webmanifest /robots.txt /sitemap.xml
  }
  header @dynamic Cache-Control "no-cache, no-store, must-revalidate"

  reverse_proxy web:3000

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
    -Server
  }
}

api.{$APP_DOMAIN} {
  encode zstd gzip
  reverse_proxy api:4000

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    -Server
  }
}

media.{$APP_DOMAIN} {
  reverse_proxy minio:9000

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    -Server
  }
}
